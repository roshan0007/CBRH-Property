import HowItWorks from '../components/HowItWorks.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
---

<Base>
  <Header />
  <main id="main">
    <Hero />
    <EnquiryForm />
    <HowItWorks />
  </main>
  <Footer />
  <StickyCta />
  <ConsentBanner />
</Base>
