---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Opportunity from '../components/Opportunity.astro';
import CaseStudy from '../components/CaseStudy.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
---

<Base>
  <Header />
  <main id="main">
    <Hero />
    <EnquiryForm />
    <HowItWorks />
    <Opportunity />
    <CaseStudy />
    <Faq />
    <FinalCta />
  </main>
  <Footer />
  <StickyCta />
  <ConsentBanner />
</Base>
