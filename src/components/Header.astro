---
import Logo from './Logo.astro';
const nav = [
  { href: '#how-it-works', label: 'How it works' },
  { href: '#packages', label: 'Packages' },
  { href: '#case-study', label: 'Case study' },
  { href: '#faqs', label: 'FAQs' },
];
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-40 border-b border-line-on-dark transition-colors duration-300 data-[scrolled]:bg-surface-dark/85 data-[scrolled]:backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-5 sm:h-20 sm:px-8 lg:px-12">
    <a href="#top" class="rounded-sm" aria-label="Hi-Ho Investments, back to top"><Logo /></a>
    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex gap-10 text-sm text-on-dark-muted">
        {nav.map((n) => <li><a href={n.href} class="transition-colors hover:text-on-dark">{n.label}</a></li>)}
      </ul>
    </nav>
    <a href="#enquire" class="btn btn-ghost-dark min-h-11 px-4 sm:px-5">
      Enquire <span class="btn-arrow" aria-hidden="true">→</span>
    </a>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const onScroll = () => header?.toggleAttribute('data-scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
