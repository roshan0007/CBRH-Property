---
// HH mark + wordmark. The mark is the client's favicon.svg without its tile,
// recoloured per surface so the first H stays visible on dark backgrounds.
interface Props {
  tone?: 'dark' | 'light';
  class?: string;
}
const { tone = 'dark', class: className = '' } = Astro.props;
const onDark = tone === 'dark';
---

<span class:list={['inline-flex items-center gap-3', className]}>
  <svg viewBox="7 9 56 46" class="h-7 w-auto flex-none sm:h-8" aria-hidden="true" focusable="false">
    <path d="M7 9h10v18h11V9h10v46H28V38H17v17H7z" class={onDark ? 'fill-logo-light' : 'fill-logo-ink'}></path>
    <path
      d="M7 34c5 0 9-6 14-6s10 6 17 6"
      fill="none"
      stroke-width="2.5"
      stroke-linecap="round"
      class={onDark ? 'stroke-surface-dark' : 'stroke-surface-paper'}></path>
    <path fill-rule="evenodd" d="M37 9h8v15h10V9h8v46h-8V40H45v15h-8zm8 25 5-5 5 5v7H45z" class="fill-logo-accent"></path>
    <path d="M49 34h3v3h-3z" class={onDark ? 'fill-surface-dark' : 'fill-surface-paper'}></path>
  </svg>
  <span class="flex flex-col leading-none">
    <span class:list={['font-display text-xl font-medium tracking-tight', onDark ? 'text-on-dark' : 'text-body']}>Hi-Ho</span>
    <span
      class:list={[
        'mt-1 text-2xs font-semibold tracking-caps uppercase',
        onDark ? 'text-on-dark-accent' : 'text-accent-text',
      ]}>Investments</span
    >
  </span>
</span>
