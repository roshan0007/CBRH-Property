---
import { Image } from 'astro:assets';
import street from '../assets/photos/terrace-street.jpg';
import { opportunity, packages, included } from '../data/content';
---

<section id="packages" class="bg-surface-dark py-24 text-on-dark sm:py-32">
  <div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-12">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-end lg:gap-20">
      <div data-reveal>
        <p class="eyebrow text-on-dark-accent">The investment opportunity</p>
        <h2 class="mt-5 font-display text-section font-medium tracking-display text-balance">{opportunity.heading}</h2>
        {opportunity.body.map((p) => <p class="mt-5 max-w-xl text-lg text-on-dark-muted">{p}</p>)}
      </div>
      <figure data-reveal>
        <Image
          src={street}
          alt="A renovated row of red-brick terraced houses on a quiet street"
          widths={[480, 800, 1200]}
          sizes="(min-width: 1024px) 40vw, 100vw"
          class="aspect-[4/3] w-full rounded-sm object-cover"
          loading="lazy"
        />
        <figcaption class="mt-3 text-xs text-on-dark-muted">Terraced homes like these are our focus. Illustrative photo.</figcaption>
      </figure>
    </div>

    <h3 class="sr-only">Service packages</h3>
    <div class="mt-20 grid gap-5 lg:grid-cols-3">
      {
        packages.map((p, pi) => (
          <article
            class:list={[
              'relative flex flex-col rounded-sm border p-7 sm:p-8',
              p.featured ? 'border-action bg-surface-dark-raised' : 'border-line-on-dark',
            ]}
            data-reveal>
            {p.featured && (
              <p class="absolute -top-3 left-7 rounded-sm bg-action px-2.5 py-1 text-xs font-semibold tracking-caps text-on-action uppercase">
                Full service
              </p>
            )}
            <p class="font-display text-2xl text-display-accent italic">Package {p.number}</p>
            <h4 class="mt-3 font-display text-xl font-medium">{p.name}</h4>
            <p class="mt-3 text-on-dark-muted">{p.summary}</p>

            <ul class="mt-7 space-y-3 border-t border-line-on-dark pt-6 text-sm">
              {included.map((row) => (
                <li class:list={['flex gap-3', !row.has[pi] && 'text-on-dark-muted']}>
                  {row.has[pi] ? (
                    <svg class="mt-0.5 size-4 flex-none text-on-dark-accent" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                      <path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  ) : (
                    <svg class="mt-0.5 size-4 flex-none" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                      <path d="M4 8h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                    </svg>
                  )}
                  <span>
                    <span class="sr-only">{row.has[pi] ? 'Included: ' : 'Not included: '}</span>
                    {row.label}
                  </span>
                </li>
              ))}
            </ul>

            <div class="mt-auto pt-8">
              <p class="font-semibold">{p.fee}</p>
              <p class="mt-1 text-sm text-on-dark-muted">{p.feeNote}</p>
            </div>
          </article>
        ))
      }
    </div>
    <div class="mt-12 flex justify-center" data-reveal>
      <a href="#enquire" class="btn btn-primary">Request an Investment Consultation <span class="btn-arrow" aria-hidden="true">→</span></a>
    </div>
  </div>
</section>
