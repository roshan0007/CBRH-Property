---
import { faqs } from '../data/content';
---

<section id="faqs" class="bg-surface-paper py-24 sm:py-32">
  <div class="mx-auto grid max-w-7xl gap-12 px-5 sm:px-8 lg:grid-cols-[minmax(0,4fr)_minmax(0,7fr)] lg:gap-20 lg:px-12">
    <div data-reveal>
      <p class="eyebrow text-accent-text">FAQs</p>
      <h2 class="mt-5 font-display text-section font-medium tracking-display text-balance">Questions investors ask us.</h2>
      <p class="mt-5 max-w-sm text-body-muted">
        Something else on your mind? Mention it in your enquiry and we’ll cover it on the call.
      </p>
    </div>
    <div class="border-t border-line" data-reveal>
      {
        faqs.map((f) => (
          <details class="faq border-b border-line">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-6 text-lg font-semibold">
              {f.q}
              <span class="faq-icon mt-2 flex-none" aria-hidden="true" />
            </summary>
            <p class="max-w-2xl pb-7 text-body-muted">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq-icon {
    position: relative;
    width: 0.875rem;
    height: 0.875rem;
  }
  .faq-icon::before,
  .faq-icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 1.5px;
    background-color: var(--color-accent-text);
    transition: transform 200ms var(--ease-out);
  }
  .faq-icon::after {
    transform: rotate(90deg);
  }
  .faq[open] .faq-icon::after {
    transform: rotate(0deg);
  }
</style>
