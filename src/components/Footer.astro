---
import Logo from './Logo.astro';
import { brand, risk } from '../data/content';
const year = new Date().getFullYear();
---

<footer class="border-t border-line-on-dark bg-surface-deep pt-16 pb-28 text-on-dark-muted lg:pb-12">
  <div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-12">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-20">
      <div>
        <Logo />
        <p class="mt-5 font-display text-xl text-on-dark italic">{brand.tagline}</p>
        <ul class="mt-8 space-y-3 text-sm">
          <li><a href={`mailto:${brand.email}`} class="text-on-dark hover:underline">{brand.email}</a></li>
          <li><a href={brand.website} class="hover:text-on-dark hover:underline">Learn more about Hi-Ho</a></li>
          <li><a href={brand.privacyUrl} class="hover:text-on-dark hover:underline">Privacy Policy</a></li>
          {brand.termsUrl && <li><a href={brand.termsUrl} class="hover:text-on-dark hover:underline">Terms and Conditions</a></li>}
        </ul>
      </div>
      <div class="rounded-sm border border-line-on-dark p-6 text-sm sm:p-7">
        <h2 class="font-semibold text-on-dark">Important information</h2>
        <ul class="mt-3 list-disc space-y-1.5 pl-5">
          {risk.map((r) => <li>{r}</li>)}
        </ul>
        <p class="mt-4">
          Hi-Ho Investments does not provide regulated financial advice. Fees and package details shown are examples and
          subject to confirmation.
        </p>
      </div>
    </div>
    <p class="mt-14 border-t border-line-on-dark pt-6 text-xs">© {year} {brand.legal}. All rights reserved.</p>
  </div>
</footer>
