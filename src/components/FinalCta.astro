---
import { finalCta } from '../data/content';
---

<section id="final-cta" class="bg-surface-dark py-24 text-on-dark sm:py-32">
  <div class="mx-auto max-w-4xl px-5 text-center sm:px-8" data-reveal>
    <h2 class="font-display text-section font-medium tracking-display text-balance">
      Ready to Explore Your <em class="font-normal text-display-accent">Property Investment</em> Options?
    </h2>
    <p class="mx-auto mt-6 max-w-xl text-lg text-on-dark-muted">{finalCta.body}</p>
    <a href="#enquire" class="btn btn-primary mt-10">{finalCta.cta} <span class="btn-arrow" aria-hidden="true">→</span></a>
  </div>
</section>
