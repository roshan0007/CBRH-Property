# Build-time (public) values for Astro. Copy to .env.
PUBLIC_SITE_URL=https://invest.hihoinvestments.co.uk
# Cloudflare's official Turnstile TEST site key (always passes). Replace for launch.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Leave blank and no Meta Pixel code ships at all.
PUBLIC_META_PIXEL_ID=
# "true" only at launch. Anything else adds <meta name="robots" content="noindex">.
PUBLIC_ALLOW_INDEXING=false
